{{- /* The index the search reads. */ -}}
{{- $out := slice }}
{{- range site.Pages }}
{{- if not .IsHome }}
{{- $heads := slice }}
{{- range .Fragments.HeadingsMap }}{{ $heads = $heads | append .Title }}{{ end }}
{{- $out = $out | append (dict "title" (cond (isset .Params "import") .Params.import .Title) "url" .RelPermalink "section" (.Section | default "home") "summary" (.Description | default "") "text" (printf "%s %s" (delimit $heads " ") (.Plain | truncate 1500))) }}
{{- end }}
{{- end }}
{{- $out | jsonify }}
